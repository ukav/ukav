local function highlight(box)
    if not box:IsA("BasePart") and not box:IsA("Model") then return end
    if box:FindFirstChild("MimicWarningHighlight") then return end

    local h = Instance.new("Highlight")
    h.Name = "MimicWarningHighlight"
    h.FillColor = Color3.fromRGB(255, 0, 0)
    h.OutlineColor = Color3.fromRGB(255, 0, 0)
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0
    h.Parent = box
end

-- Highlight any MimicBox already in the game
for _, obj in ipairs(workspace:GetDescendants()) do
    if obj.Name == "MimicBox" then
        highlight(obj)
    end
end

-- Catch any MimicBox that spawns later
workspace.DescendantAdded:Connect(function(obj)
    if obj.Name == "MimicBox" then
        highlight(obj)
    end
end)
