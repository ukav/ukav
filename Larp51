                    -- Keep player on the platform center
                    root.CFrame = part.CFrame * CFrame.new(0, 3, 0)
                    task.wait()
                end
                part:Destroy()
            end)
        else
            getgenv().ReaperTrack = false
            root.CFrame = getgenv().ReaperOldPos
        end
    end
