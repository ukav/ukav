            part.Name = "ReaperPlatform"
            part.Size = Vector3.new(10, 1, 10)
            part.Transparency = 1
            part.Anchored = true
            part.CanCollide = true -- Allow walking on it
            part.Parent = workspace
            
            task.spawn(function()
                while getgenv().ReaperTrack and npcRoot.Parent and root and root.Parent do
                    -- Keep platform at NPC position + 10 studs up
