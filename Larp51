Tab:CreateButton({
    Name = "Reaper",
    Callback = function()
        local player = game:GetService("Players").LocalPlayer
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local npc = workspace:FindFirstChild("Reaper")
        local npcRoot = npc and (npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc:FindFirstChild("UpperTorso"))
        if not root or not npcRoot then return end
        if not getgenv().ReaperTrack then
            getgenv().ReaperTrack = true
            getgenv().ReaperOldPos = root.CFrame
            local part = Instance.new("Part")
            part.Name = "ReaperPlatform"
            part.Size = Vector3.new(10, 1, 10)
            part.Transparency = 1
            part.Anchored = true
            part.CanCollide = true
            part.Parent = workspace
            task.spawn(function()
                while getgenv().ReaperTrack do
                    if not (npc and npc.Parent and npcRoot and npcRoot.Parent and root and root.Parent) then
                        getgenv().ReaperTrack = false
                        break
                    end
                    part.CFrame = npcRoot.CFrame * CFrame.new(0, 15, 0)
                    root.CFrame = part.CFrame * CFrame.new(0, 3, 0)
                    task.wait()
                end
                part:Destroy()
            end)
        else
            getgenv().ReaperTrack = false
            if root and root.Parent then
                root.CFrame = getgenv().ReaperOldPos
            end
        end
    end
})
