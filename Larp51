-- Local helper functions
local function resetCharacter()
   task.wait(0.5)
   local char = player.Character
   if char then
       local humanoid = char:FindFirstChildOfClass("Humanoid")
       if humanoid then
           humanoid.Health = 0
       end
   end
end

local function teleportToLobby(root)
    local entrance = game:GetService("Workspace"):FindFirstChild("Ground") and game:GetService("Workspace").Ground:FindFirstChild("Entrance")
    
    while entrance and entrance.CanCollide == true do
        root.CFrame = CFrame.new(624, 1090, 750.5)
        task.wait(1.5)
    end
end

