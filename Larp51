local Button = Tab:CreateButton({
    Name = "Get Burning Sword",
    Callback = function()
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = char:WaitForChild("HumanoidRootPart")
        local camera = workspace.CurrentCamera
        teleportToLobby(root)
        local function getNearestPrompt()
            local nearest, shortest = nil, math.huge
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") and v.Enabled then
                    local part = v.Parent:IsA("BasePart") and v.Parent
                    if part then
                        local dist = (root.Position - part.Position).Magnitude
                        if dist < shortest then
                            shortest = dist
                            nearest = v
                        end
                    end
                end
            end
            return nearest
        end
        local function spamPrompt(prompt)
            local startTime = tick()
            while tick() - startTime < 0.1 do
                prompt:InputHoldBegin()
                prompt:InputHoldEnd()
                task.wait()
            end
        end

        camera.CFrame = CFrame.new(598, 1166, 759, 1, 0, 0, 0, 0, 1, 0, 1, 0)

        local waypoints = {
            Vector3.new(-268, 1052, 1128),
            Vector3.new(-268, 1052, 1189),
            Vector3.new(-174, 1062, 1138),
            Vector3.new(-174, 1062, 1178),
            Vector3.new(-134, 1062, 1178),
            Vector3.new(-135, 1062, 1139),
            Vector3.new(-20, 1052, 1159),
        }

        for _, pos in ipairs(waypoints) do
            root.CFrame = CFrame.new(pos)
            task.wait(0.1)

            local prompt = getNearestPrompt()
            if prompt then
                spamPrompt(prompt)
            end
        end

        root.CFrame = CFrame.new(63, 1079, 1159)

        resetCharacter()
    end,
})

