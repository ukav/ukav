Tab:CreateButton({
    Name = "Supply Crates & Balls",
    Callback = function()
        local UserInputService = game:GetService("UserInputService")
        local RunService = game:GetService("RunService")
        local Players = game:GetService("Players")

        local LocalPlayer = Players.LocalPlayer
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = char:WaitForChild("HumanoidRootPart")

        local oldPos = root.CFrame

        -- Create temporary platform
        local platform = Instance.new("Part")
        platform.Size = Vector3.new(2, 1, 2)
        platform.Transparency = 1
        platform.Anchored = true
        platform.CanCollide = true
        platform.Parent = workspace

        -- Enable Noclip
        local noclipConnection
        noclipConnection = RunService.Stepped:Connect(function()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)

        local skipCurrent = false
        local connection
        connection = UserInputService.InputBegan:Connect(function(input, gpe)
            if not gpe and input.KeyCode == Enum.KeyCode.Q then
                skipCurrent = true
            end
        end)

        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and (v.Name == "SupplyCrate" or v.Name == "SupplyBall") then
                local prompt = v:FindFirstChildOfClass("ProximityPrompt") or v:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    skipCurrent = false
                    
                    local startTime = tick()
                    repeat
                        local targetCF = v.CFrame * CFrame.new(0, -4, 0)
                        root.CFrame = targetCF
                        platform.CFrame = targetCF * CFrame.new(0, -3.5, 0)
                        
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        
                        fireproximityprompt(prompt, 0)
                        task.wait(0.1)
                    until not prompt.Parent or not prompt.Enabled or skipCurrent or (tick() - startTime > 10)
                    
                    if not skipCurrent then
                        local holdTime = tick()
                        while tick() - holdTime < 1 and not skipCurrent do
                            local targetCF = v.CFrame * CFrame.new(0, -4, 0)
                            root.CFrame = targetCF
                            platform.CFrame = targetCF * CFrame.new(0, -3.5, 0)
                            
                            root.AssemblyLinearVelocity = Vector3.zero
                            root.AssemblyAngularVelocity = Vector3.zero
                            task.wait(0.1)
                        end
                    end
                end
            end
        end

        if connection then
            connection:Disconnect()
        end

        -- Disable Noclip & cleanup
        if noclipConnection then
            noclipConnection:Disconnect()
        end

        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end

        platform:Destroy()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = oldPos
    end,
})

