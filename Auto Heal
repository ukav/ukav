local player = game.Players.LocalPlayer
local toggle = false

RunService.RenderStepped:Connect(function()
    local char = player.Character
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") and v.Name == "Cleansed Rifle" then
                v.GripPos = Vector3.new(300, 300, 300)
            end
        end
    end
end)

coroutine.wrap(function()
    while true do
        if toggle then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local torso = char and (char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
            local rifle = player.Backpack:FindFirstChild("Cleansed Rifle") or (char and char:FindFirstChild("Cleansed Rifle"))
            
            if hum and rifle then
                if rifle.Parent ~= char then
                    rifle.Parent = char 
                end
                
                local event = rifle:FindFirstChild("GunScript_Server") and rifle.GunScript_Server:FindFirstChild("InflictTarget")
                if event then
                    event:FireServer(
                        "Torso",
                        hum,
                        torso,
                        rifle,
                        Vector3.new(0.41955700516701, -0.16235166788101, 0.89309215545654)
                    )
                end
            end
        end
        task.wait(0.1)
    end
end)()

TextButton.MouseButton1Click:Connect(function()
    toggle = not toggle
    TextButton.Text = toggle and "ON" or "OFF"
end)

CloseButton.MouseButton1Click:Connect(function()
    toggle = false
    ScreenGui:Destroy()
end)
