local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

local function collectSupplyBoxes()
    -- Use GetDescendants to find objects inside folders/models
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "SupplyBox" and obj:IsA("BasePart") then
            -- Teleport to the box
            humanoidRootPart.CFrame = obj.CFrame + Vector3.new(0, 3, 0)
            task.wait(0.5)

            -- Find and trigger the prompt correctly
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
            if prompt then
                -- Standard way to trigger a prompt via script
                fireproximityprompt(prompt) 
            end
            
            task.wait(0.5)
        end
    end
end

collectSupplyBoxes()
