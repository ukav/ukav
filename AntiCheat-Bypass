local Players = game:GetService("Players")
local player = Players.LocalPlayer

local function teleportToLobby(root)
    local entrance = game:GetService("Workspace"):FindFirstChild("Ground") and game:GetService("Workspace").Ground:FindFirstChild("Entrance")
    
    while entrance and entrance.CanCollide == true do
        root.CFrame = CFrame.new(624, 1090, 750.5)
        task.wait(1.5)
    end
end

local function tweenPositions()
    local char = player.Character or player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local originalCF = root.CFrame

    teleportToLobby(root)

    local oldGravity = workspace.Gravity
    workspace.Gravity = 240

    root.CFrame = CFrame.new(624, 1090 + 10, 750.5)

    task.wait(1)

    workspace.Gravity = oldGravity
    root.CFrame = originalCF
end

tweenPositions()
